# Copie para .env e preencha. Nunca versione o .env real.

# Firebase (configuração web do projeto de desenvolvimento)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Domínio do e-mail interno das contas de van (o motorista não vê). Padrão: vans.crazycravings.ca
# VITE_VAN_EMAIL_DOMAIN=

# Rastreamento da van (GPS) durante o turno. Ligado por padrão; 'false' desliga.
# VITE_TRACKING=false

# Clover (sandbox). Tokens OAuth ficam apenas em variáveis de ambiente do servidor.
CLOVER_ENV=sandbox
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
